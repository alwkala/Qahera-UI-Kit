# ==============================================================================
# Qahera UI Kit — Core Repository .gitignore
# Strictly guards against consumer artifacts, marketing leaks, and binary bloat
# ==============================================================================

# 1. Dependencies
node_modules/
package-lock.json.bak

# 2. Build and Cache
.cache/
dist/tmp/
*.tmp
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 3. Environment and Secrets
.env
.env.local
.env.*.local

# 4. Operating System & IDE
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# 5. Downstream Consumer Sites & Marketing Isolation (STRICT BAN in Core Repo)
site-marketing/
style-guide/
marketing/
website/
showcase-site/
landing-site/

# 6. Large Design Archives & Raw Assets
*.zip
*.tar
*.tar.gz
*.rar
*.7z
*.psd
*.ai
*.fig
*.sketch

# 7. Temporary Scratch Files & Agent Artifacts
scratch/
.gemini/
Qahera-UI-Kit.code-workspace
