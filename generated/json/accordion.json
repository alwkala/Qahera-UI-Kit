{
  "id": "accordion",
  "name": "Accordion",
  "component": "Accordion",
  "category": "disclosure",
  "version": "1.0.0",
  "contract": {
    "anatomy": [
      "root",
      "item",
      "header-button",
      "header-title",
      "chevron-icon",
      "content-region",
      "content-body"
    ],
    "variants": [
      "bordered",
      "separate",
      "flush"
    ],
    "sizes": [
      "sm",
      "md"
    ],
    "states": [
      "collapsed",
      "expanded"
    ],
    "slots": [
      "default"
    ],
    "accessibility": {
      "role": "region",
      "keyboard": {
        "Enter": "Toggles expanded state of focused accordion item",
        "Space": "Toggles expanded state of focused accordion item",
        "ArrowDown": "Moves focus to next header",
        "ArrowUp": "Moves focus to previous header"
      },
      "focus": "Ring around focused header button",
      "aria": [
        {
          "aria-expanded": "when item is open"
        },
        {
          "aria-controls": "matching content panel id"
        }
      ]
    }
  },
  "recipe": {
    "file": "recipes/accordion.yaml",
    "base": {
      "display": "flex",
      "flex-direction": "column",
      "width": "100%",
      "border": "1px solid {color.border.subtle}",
      "border-radius": "{radius.lg}",
      "overflow": "hidden"
    },
    "variants": {
      "bordered": {
        "border": "1px solid {color.border.subtle}"
      },
      "separate": {
        "gap": "{space.2}",
        "border": "none"
      },
      "flush": {
        "border-radius": 0,
        "border-inline": "none"
      }
    },
    "sizes": {
      "sm": {
        "font-size": "{text.sm}",
        "padding": "{space.3}"
      },
      "md": {
        "font-size": "{text.base}",
        "padding": "{space.4}"
      }
    },
    "states": {
      "collapsed": {
        "max-height": 0
      },
      "expanded": {
        "max-height": "auto"
      }
    }
  },
  "behavior": {
    "file": "behavior/accordion.js",
    "moduleName": "accordion"
  },
  "ai": {
    "purpose": "Organizes deep information in vertically stacked collapsible panels.",
    "whenToUse": [
      "Frequently Asked Questions (FAQ) sections",
      "Nested product specifications or collapsible settings"
    ],
    "avoid": [
      "All content must be visible at the same glance"
    ],
    "related": []
  },
  "source": {
    "file": "contracts/components/Accordion.yaml"
  }
}
