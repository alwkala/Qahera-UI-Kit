{
  "id": "preloader",
  "name": "Preloader",
  "component": "Preloader",
  "category": "feedback",
  "version": "1.0.0",
  "contract": {
    "anatomy": [
      "root",
      "content",
      "logo",
      "progress-track",
      "progress-bar",
      "percentage"
    ],
    "variants": {
      "default": {
        "intent": "standard-page-preloader"
      },
      "luxury": {
        "intent": "luxury-obsidian-gold-cinematic"
      }
    },
    "sizes": {
      "md": {
        "max_width": 280,
        "padding": 0
      }
    },
    "states": [
      "active",
      "completing",
      "dismissed"
    ],
    "slots": {
      "logo": "optional",
      "percentage": "optional"
    },
    "accessibility": {
      "role": "status",
      "aria": [
        {
          "aria-live": "polite"
        },
        {
          "aria-atomic": "true"
        }
      ]
    }
  },
  "recipe": {
    "file": "recipes/preloader.yaml",
    "base": {
      "position": "fixed",
      "inset": 0,
      "background-color": "var(--qhr-color-bg)",
      "z-index": 9999,
      "display": "flex",
      "align-items": "center",
      "justify-content": "center",
      "transition": "opacity 0.6s var(--qhr-motion-luxury, cubic-bezier(0.25, 0.8, 0.25, 1))"
    },
    "variants": {
      "default": {
        "background-color": "var(--qhr-color-bg)"
      },
      "luxury": {
        "background-color": "var(--qhr-color-bg)",
        "border-top": "2px solid var(--qhr-color-gold)"
      }
    },
    "sizes": {
      "md": {
        "max-width": "280px"
      }
    },
    "states": {
      "active": {
        "opacity": 1,
        "pointer-events": "auto"
      },
      "dismissed": {
        "opacity": 0,
        "pointer-events": "none"
      }
    }
  },
  "behavior": {
    "file": "behavior/preloader.js",
    "moduleName": "preloader"
  },
  "ai": {
    "purpose": "Displays an atmospheric initial loading overlay with logo, animated progress bar, and digital percentage before revealing cinematic or rich page content.",
    "whenToUse": [
      "First-time application loads, heavy cinematic presentations, or portfolio landing pages"
    ],
    "avoid": [
      "Internal page-to-page SPA transitions or individual component async data fetching"
    ],
    "related": []
  },
  "source": {
    "file": "contracts/components/Preloader.yaml"
  }
}
