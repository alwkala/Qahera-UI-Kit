{
  "id": "skeleton",
  "name": "Skeleton",
  "component": "Skeleton",
  "category": "feedback",
  "version": "1.0.0",
  "contract": {
    "anatomy": [
      "root"
    ],
    "variants": {
      "default": {
        "intent": "neutral-shimmer"
      },
      "wave": {
        "intent": "high-contrast-pulse"
      }
    },
    "sizes": {
      "sm": {
        "height": 16
      },
      "md": {
        "height": 24
      },
      "lg": {
        "height": 48
      }
    },
    "states": [
      "active"
    ],
    "slots": {
      "default": "optional"
    },
    "accessibility": {
      "role": "status",
      "aria": {
        "0": {
          "\"aria-busy\"": "true"
        },
        "1": {
          "\"aria-label\"": "Loading content placeholder"
        }
      }
    }
  },
  "recipe": {
    "file": "recipes/skeleton.yaml",
    "base": {
      "display": "block",
      "background-color": "{color.surface.elevated}",
      "border-radius": "{radius.md}",
      "position": "relative",
      "overflow": "hidden"
    },
    "variants": {
      "default": {
        "opacity": 0.8
      },
      "wave": {
        "opacity": 1
      }
    },
    "sizes": {
      "sm": {
        "height": "16px"
      },
      "md": {
        "height": "24px"
      },
      "lg": {
        "height": "48px"
      }
    },
    "states": {
      "loading": {
        "animation": "qhr-shimmer 1.5s infinite linear"
      },
      "idle": {
        "animation": "none"
      }
    }
  },
  "behavior": null,
  "ai": {
    "purpose": "Displays animated shimmer placeholders simulating layout geometry while asynchronous data loads.",
    "whenToUse": [
      "Card loading state",
      "Avatar and profile header loading",
      "Table rows during pagination or initial fetch"
    ],
    "avoid": [
      "Long-term blocking operations where progress percentage is known (use Progress)"
    ],
    "related": []
  },
  "source": {
    "file": "contracts/components/Skeleton.yaml"
  }
}
