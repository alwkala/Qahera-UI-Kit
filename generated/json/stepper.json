{
  "id": "stepper",
  "name": "Stepper",
  "component": "Stepper",
  "category": "navigation",
  "version": "1.0.0",
  "contract": {
    "anatomy": [
      "root",
      "step-list",
      "step-item",
      "step-indicator",
      "step-line",
      "step-label",
      "step-description"
    ],
    "variants": {
      "horizontal": {
        "intent": "standard-horizontal-stepper"
      },
      "vertical": {
        "intent": "side-panel-linear-steps"
      },
      "numbers": {
        "intent": "explicit-numeric-indicators"
      },
      "dots": {
        "intent": "compact-dot-stepper"
      }
    },
    "sizes": {
      "sm": {
        "indicator_size": 24,
        "font_size": "var(--qhr-text-xs)"
      },
      "md": {
        "indicator_size": 32,
        "font_size": "var(--qhr-text-sm)"
      },
      "lg": {
        "indicator_size": 40,
        "font_size": "var(--qhr-text-base)"
      }
    },
    "states": [
      "upcoming",
      "current",
      "completed",
      "disabled"
    ],
    "slots": {
      "steps": "required",
      "indicator": "optional",
      "content": "optional"
    },
    "accessibility": {
      "role": "navigation",
      "aria": [
        "aria-label=steps",
        "aria-current=step"
      ],
      "keyboard": true,
      "focusVisible": true
    }
  },
  "recipe": {
    "file": "recipes/stepper.yaml",
    "base": {
      "display": "flex",
      "align-items": "center",
      "width": "100%",
      "list-style": "none",
      "margin": 0,
      "padding": 0,
      "font-family": "{font.family.body}"
    },
    "variants": {
      "horizontal": {
        "flex-direction": "row",
        "justify-content": "space-between"
      },
      "vertical": {
        "flex-direction": "column",
        "align-items": "flex-start"
      },
      "numbers": {
        "gap": "{space.4}"
      },
      "dots": {
        "gap": "{space.2}"
      }
    },
    "sizes": {
      "sm": {
        "font-size": "{text.xs}",
        "gap": "{space.2}"
      },
      "md": {
        "font-size": "{text.sm}",
        "gap": "{space.4}"
      },
      "lg": {
        "font-size": "{text.base}",
        "gap": "{space.6}"
      }
    },
    "states": {
      "upcoming": {
        "opacity": 0.6
      },
      "current": {
        "font-weight": 700
      },
      "completed": {
        "opacity": 1
      },
      "disabled": {
        "opacity": 0.4
      }
    }
  },
  "behavior": null,
  "ai": {
    "purpose": "Guides users through a sequential multi-step workflow, depicting completed, active, and upcoming stages.",
    "whenToUse": [
      "Multi-step enterprise registration (e.g. Register 2)",
      "E-Commerce checkout (Cart -> Shipping -> Payment -> Confirmation)",
      "Onboarding wizards and system setup procedures"
    ],
    "avoid": [
      "Continuous percentage metrics without discrete steps (use Progress)",
      "Independent tabs without chronological order (use Tabs)"
    ],
    "related": []
  },
  "source": {
    "file": "contracts/components/Stepper.yaml"
  }
}
