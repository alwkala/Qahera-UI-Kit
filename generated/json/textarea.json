{
  "id": "textarea",
  "name": "Textarea",
  "component": "Textarea",
  "category": "forms",
  "version": "1.0.0",
  "contract": {
    "anatomy": [
      "root",
      "control",
      "resize-handle"
    ],
    "variants": [
      "default",
      "filled"
    ],
    "sizes": [
      "sm",
      "md",
      "lg"
    ],
    "states": [
      "default",
      "hover",
      "focus",
      "disabled",
      "invalid"
    ],
    "slots": [
      "default"
    ],
    "accessibility": {
      "role": "textbox",
      "keyboard": {
        "Standard": "Native multi-line textarea editing keys"
      },
      "focus": "Border color changes to primary with ring focus",
      "aria": [
        {
          "aria-invalid": "when state=invalid"
        }
      ]
    }
  },
  "recipe": {
    "file": "recipes/textarea.yaml",
    "base": {
      "display": "flex",
      "width": "100%",
      "min-height": "100px",
      "font-family": "inherit",
      "background-color": "{color.surface.base}",
      "color": "{color.neutral.900}",
      "border": "1px solid {color.border.subtle}",
      "border-radius": "{radius.md}",
      "outline": "none",
      "resize": "vertical",
      "transition-duration": "{duration.fast}",
      "transition-timing-function": "{ease.standard}"
    },
    "variants": {
      "default": {
        "background-color": "{color.surface.base}",
        "border-color": "{color.border.subtle}"
      },
      "filled": {
        "background-color": "{color.neutral.100}",
        "border-color": "transparent"
      }
    },
    "sizes": {
      "sm": {
        "font-size": "{text.sm}",
        "padding-inline": "{space.2-5}",
        "padding-block": "{space.2}",
        "border-radius": "{radius.sm}"
      },
      "md": {
        "font-size": "{text.base}",
        "padding-inline": "{space.3}",
        "padding-block": "{space.2-5}",
        "border-radius": "{radius.md}"
      },
      "lg": {
        "font-size": "{text.lg}",
        "padding-inline": "{space.4}",
        "padding-block": "{space.3}",
        "border-radius": "{radius.lg}"
      }
    },
    "states": {
      "hover": {
        "border-color": "{color.primary.bg}"
      },
      "focus": {
        "border-color": "{color.primary.bg}",
        "outline": "2px solid {color.primary.subtle}"
      },
      "disabled": {
        "background-color": "{color.neutral.100}",
        "opacity": 0.6,
        "cursor": "not-allowed"
      },
      "invalid": {
        "border-color": "{color.danger.bg}",
        "outline": "2px solid {color.danger.subtle}"
      }
    }
  },
  "behavior": null,
  "ai": {
    "purpose": "Captures multi-line freeform textual data from the user.",
    "whenToUse": [
      "Extended descriptions, reviews, notes, support messages"
    ],
    "avoid": [
      "Short single-line fields (use Input)"
    ],
    "related": []
  },
  "source": {
    "file": "contracts/components/Textarea.yaml"
  }
}
